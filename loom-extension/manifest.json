{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://sentria-oneiro.vercel.app/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
